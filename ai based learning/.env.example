# ==============================================================================
# StatSaksham AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env in your root and/or backend folder and set your variables.
# Do NOT commit your real .env file with production secrets to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration
# ------------------------------------------------------------------------------
# Google Gemini API Key
# (Leave blank to use the built-in deterministic Mock LLM provider for local development/testing)
GEMINI_API_KEY=your_gemini_api_key_here

# Application Environment (development / staging / production)
ENVIRONMENT=development

# Server Port
PORT=8000

# File Upload Settings
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIR=data/uploads

# Document Chunking Settings
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Embedding Model Configuration
# Uses HuggingFace sentence-transformers locally
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite)
# ------------------------------------------------------------------------------
# API Base URL for React frontend communication with the FastAPI backend
VITE_API_URL=http://localhost:8000/api
